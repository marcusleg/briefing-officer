AUTH_SECRET=lorem-ipsum
NEXT_PUBLIC_AUTH_GENERIC_OAUTH_ENABLE=false
NEXT_PUBLIC_AUTH_GENERIC_OAUTH_PROVIDER_NAME=
AUTH_GENERIC_OAUTH_CLIENT_ID=
AUTH_GENERIC_OAUTH_CLIENT_SECRET=
AUTH_GENERIC_OAUTH_DISCOVERY_URL=
AUTH_GENERIC_OAUTH_PKCE_ENABLED=true

# Configure one AI provider using the appropriate credentials below
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AZURE_OPENAI_API_KEY=0123456789abcdef
AZURE_OPENAI_MODEL=gpt-5-nano
AZURE_OPENAI_RESOURCE_NAME=oai-example-dev-001
# OpenAI or OpenAI-compatible provider (e.g., OpenAI, Portkey, OpenRouter, etc.)
# OPENAI_BASE_URL defaults to https://api.openai.com/v1 if not set
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

BASE_URL=http://localhost:3000
# Minutes between automatic feed refreshes. Defaults to 15.
#FEED_REFRESH_INTERVAL_MINUTES=15
# Set to true to run the web app without the background worker.
#BACKGROUND_WORKER_DISABLED=true
DATABASE_URL=file:./data/database.sqlite
